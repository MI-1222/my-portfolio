---
/**
 * 制作物(詳細仕様書)用 HUD ヘッダーコンポーネント。
 * システムステータス、定量的メトリクス、CLI連携コマンドを提示する。
 */
import GitHubIcon from '../svg/GitHubIcon.astro';
import OpenInNewSvg from '../svg/OpenInNew.astro';

/** 工学的メトリクス項目の型定義。 */
interface MetricItem {
  /** メトリクスのラベル名。 */
  label: string;
  /** メトリクスの数値または単位付き文字列。 */
  value: string;
}

/** HUD ヘッダーコンポーネントのプロパティ定義。 */
interface Props {
  /** 制作物の名称。 */
  title: string;
  /** サブタイトルまたは概要。 */
  subtitle: string;
  /** 表示用カテゴリラベル。 */
  categoryLabel: string;
  /** 開発ステータス。 */
  status: 'OSS' | 'RESEARCH' | 'INTERNAL' | 'PLANNING';
  /** テーマアクセントカラー。 */
  accent: 'cyan' | 'green' | 'coral' | 'purple';
  /** 初回公開日。 */
  publishedAt: Date;
  /** 最終更新日。 */
  updatedAt?: Date;
  /** 関連技術スタックタグ一覧。 */
  tags: string[];
  /** 定量メトリクス一覧。 */
  metrics?: MetricItem[];
  /** GitHub リポジトリ URL。 */
  githubUrl?: string;
  /** デモサイト URL。 */
  demoUrl?: string;
  /** 動作検証済みバージョン一覧。 */
  verifiedVersions?: string[];
  /** ターミナル実行コマンド。 */
  cliCommand?: string;
}

const {
  title,
  subtitle,
  categoryLabel,
  status,
  accent,
  publishedAt,
  updatedAt,
  tags,
  metrics = [],
  githubUrl,
  demoUrl,
  verifiedVersions = [],
  cliCommand,
} = Astro.props;

/** 日付を `YYYY.MM.DD` 形式の文字列に変換する。 */
function formatDate(date: Date): string {
  const y = date.getFullYear();
  const m = String(date.getMonth() + 1).padStart(2, '0');
  const d = String(date.getDate()).padStart(2, '0');
  return `${y}.${m}.${d}`;
}

/** ステータス別の配色マッピング。 */
const statusColorMap = {
  OSS: 'bg-accent-green text-accent-green',
  RESEARCH: 'bg-accent-purple text-accent-purple',
  INTERNAL: 'bg-text-muted text-text-muted',
  PLANNING: 'bg-accent-coral text-accent-coral',
};

/** アクセントカラー別の境界線と文字色のマッピング。 */
const accentBorderMap = {
  cyan: 'border-accent-cyan/30 text-accent-cyan',
  green: 'border-accent-green/30 text-accent-green',
  coral: 'border-accent-coral/30 text-accent-coral',
  purple: 'border-accent-purple/30 text-accent-purple',
};
---

<header class="border-b border-border-subtle pb-10 pt-6">
  <div class="mb-6 flex flex-wrap items-center justify-between gap-4 font-mono text-xs">
    <a
      href="/#works"
      class="group inline-flex items-center gap-1.5 text-text-secondary transition-colors hover:text-accent-cyan"
    >
      <span class="transition-transform group-hover:-translate-x-0.5">←</span>
      <span>Index of Works</span>
    </a>

    <div class="flex items-center gap-2 text-text-muted">
      <span>SYS.SPEC //</span>
      <span class="text-text-secondary uppercase">{status}</span>
      <span>//</span>
      <span>REV.{formatDate(updatedAt || publishedAt)}</span>
    </div>
  </div>

  <div class="space-y-3">
    <div class="flex flex-wrap items-center gap-2 font-mono text-xs">
      <span
        class:list={[
          'rounded border bg-surface-subtle px-2 py-0.5',
          accentBorderMap[accent],
        ]}
      >
        {categoryLabel}
      </span>
      <span class="inline-flex items-center gap-1.5 rounded border border-border-subtle bg-surface px-2 py-0.5 text-text-secondary">
        <span
          class:list={[
            'h-1.5 w-1.5 rounded-full',
            statusColorMap[status].split(' ')[0],
          ]}
        ></span>
        <span>{status}</span>
      </span>
      {verifiedVersions.length > 0 && (
        <span class="text-text-muted">Verified: {verifiedVersions[0]}</span>
      )}
    </div>

    <h1 class="text-3xl font-extrabold tracking-tight text-text-primary sm:text-5xl">
      {title}
    </h1>
    <p class="max-w-3xl text-base text-text-secondary sm:text-lg">{subtitle}</p>
  </div>

  {tags.length > 0 && (
    <div class="mt-4 flex flex-wrap gap-1.5 font-mono text-xs">
      {tags.map((tag) => (
        <span class="rounded border border-border-subtle bg-surface px-2 py-0.5 text-text-secondary">
          #{tag}
        </span>
      ))}
    </div>
  )}

  {metrics.length > 0 && (
    <div class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-4">
      {metrics.map((m) => (
        <div class="rounded-lg border border-border-subtle bg-surface p-3.5 transition-colors hover:border-border-strong">
          <div class="font-mono text-[11px] uppercase tracking-wider text-text-muted">
            {m.label}
          </div>
          <div class="mt-1 font-mono text-lg font-bold text-text-primary sm:text-xl">
            {m.value}
          </div>
        </div>
      ))}
    </div>
  )}

  <div class="mt-8 flex flex-wrap items-center justify-between gap-4 border-t border-border-subtle/60 pt-6">
    <div class="flex flex-wrap items-center gap-3">
      {githubUrl && (
        <a
          href={githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-md border border-border-subtle bg-surface px-3.5 py-2 font-mono text-xs font-medium text-text-primary transition-colors hover:border-border-strong hover:bg-surface-hover"
        >
          <span class="size-4">
            <GitHubIcon />
          </span>
          <span>View on GitHub</span>
          <span class="size-3 text-text-muted">
            <OpenInNewSvg />
          </span>
        </a>
      )}

      {demoUrl && (
        <a
          href={demoUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-md border border-accent-cyan/40 bg-accent-cyan/10 px-3.5 py-2 font-mono text-xs font-semibold text-accent-cyan transition-colors hover:bg-accent-cyan/20"
        >
          <span>Live Demo</span>
          <span class="size-3">
            <OpenInNewSvg />
          </span>
        </a>
      )}
    </div>

    {cliCommand && (
      <button
        type="button"
        id="run-cli-command-btn"
        data-command={cliCommand}
        class="group inline-flex items-center gap-2 rounded-md border border-accent-green/30 bg-surface px-3 py-2 font-mono text-xs text-text-secondary transition-colors hover:border-accent-green/60 hover:text-text-primary"
        title="ターミナルを起動して実行"
      >
        <span class="text-accent-green">[&gt;_]</span>
        <span class="text-text-muted">Run:</span>
        <code class="text-accent-green">{cliCommand}</code>
      </button>
    )}
  </div>
</header>

<script>
  /** ターミナル実行ボタンのクリックイベントを設定する。 */
  function setupCliButton(): void {
    const btn = document.getElementById('run-cli-command-btn');
    if (!btn) {
      return;
    }

    btn.addEventListener('click', () => {
      const command = btn.getAttribute('data-command');
      if (command) {
        window.dispatchEvent(
          new CustomEvent('open-terminal', {
            detail: { command },
          }),
        );
      }
    });
  }

  document.addEventListener('astro:page-load', setupCliButton);
</script>
