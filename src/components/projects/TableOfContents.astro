---
/**
 * 記事詳細ページ用 Sticky Table of Contents (目次) コンポーネント。
 * 見出し階層の描画、現在位置のスクロールスパイハイライト、読了進捗表示を提供する。
 */

/** 見出し項目の型定義。 */
interface HeadingItem {
  /** 見出しの深さレベル(2: h2, 3: h3)。 */
  depth: number;
  /** 見出し要素のアンカー識別子。 */
  slug: string;
  /** 見出しの表示文字列。 */
  text: string;
}

/** 目次コンポーネントのプロパティ定義。 */
interface Props {
  /** 記事から抽出された全見出し一覧。 */
  headings: HeadingItem[];
}

const { headings } = Astro.props;

/** 目次として表示する見出し要素 (`h2`, `h3`) を抽出した配列。 */
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{tocHeadings.length > 0 && (
  <nav
    id="project-toc"
    class="sticky top-24 space-y-4 rounded-lg border border-border-subtle bg-surface/50 p-4 backdrop-blur-sm"
    aria-label="記事の目次"
  >
    <div class="flex items-center justify-between border-b border-border-subtle/80 pb-2.5 font-mono text-[11px]">
      <span class="flex items-center gap-1.5 text-text-primary">
        <span class="text-accent-green">§</span>
        <span>CONTENTS</span>
      </span>
      <span id="toc-progress-text" class="text-text-muted">
        0%
      </span>
    </div>

    <div class="h-0.5 w-full overflow-hidden rounded-full bg-surface-subtle">
      <div
        id="toc-progress-bar"
        class="h-full w-0 bg-accent-green transition-all duration-150"
      ></div>
    </div>

    <ul class="space-y-1.5 font-mono text-xs max-h-[calc(100vh-14rem)] overflow-y-auto pr-1">
      {tocHeadings.map((heading) => (
        <li class:list={[heading.depth === 3 && 'pl-3 text-[11px]']}>
          <a
            href={`#${heading.slug}`}
            data-toc-link={heading.slug}
            class="block py-1 text-text-secondary transition-colors hover:text-text-primary border-l-2 border-transparent pl-2"
          >
            {heading.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}

<script>
  /** 現在稼働中の `IntersectionObserver` インスタンス。 */
  let activeObserver: IntersectionObserver | null = null;
  /** スクロール進捗監視用のリスナー関数。 */
  let scrollListener: (() => void) | null = null;

  /** 目次のスクロールスパイと読了進捗バーを初期化する。 */
  function setupToc(): void {
    cleanupToc();

    const toc = document.getElementById('project-toc');
    if (!toc) {
      return;
    }

    const links = Array.from(
      toc.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'),
    );
    if (links.length === 0) {
      return;
    }

    const headingIds = links
      .map((link) => link.getAttribute('data-toc-link'))
      .filter(Boolean) as string[];
    const headingElements = headingIds
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null);

    if (headingElements.length === 0) {
      return;
    }

    /**
     * 指定された見出しに対応するリンクをアクティブ状態に更新する。
     *
     * @param activeId ハイライト対象の見出し ID。
     */
    function setActiveLink(activeId: string): void {
      for (const link of links) {
        const id = link.getAttribute('data-toc-link');
        if (id === activeId) {
          link.classList.add(
            'text-accent-cyan',
            'font-semibold',
            'border-accent-cyan',
          );
          link.classList.remove('text-text-secondary', 'border-transparent');
        } else {
          link.classList.remove(
            'text-accent-cyan',
            'font-semibold',
            'border-accent-cyan',
          );
          link.classList.add('text-text-secondary', 'border-transparent');
        }
      }
    }

    if (headingIds.length > 0) {
      setActiveLink(headingIds[0]);
    }

    activeObserver = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            setActiveLink(entry.target.id);
          }
        }
      },
      {
        rootMargin: '-80px 0% -65% 0%',
        threshold: 0,
      },
    );

    for (const el of headingElements) {
      activeObserver.observe(el);
    }

    const progressBar = document.getElementById('toc-progress-bar');
    const progressText = document.getElementById('toc-progress-text');

    scrollListener = () => {
      const docHeight =
        document.documentElement.scrollHeight - window.innerHeight;
      if (docHeight <= 0) {
        return;
      }
      const scrolled = Math.min(
        100,
        Math.max(0, Math.round((window.scrollY / docHeight) * 100)),
      );
      if (progressBar) {
        progressBar.style.width = `${scrolled}%`;
      }
      if (progressText) {
        progressText.textContent = `${scrolled}%`;
      }
    };

    window.addEventListener('scroll', scrollListener, { passive: true });
    scrollListener();
  }

  /** 監視インスタンスおよびイベントリスナーを破棄する。 */
  function cleanupToc(): void {
    if (activeObserver) {
      activeObserver.disconnect();
      activeObserver = null;
    }
    if (scrollListener) {
      window.removeEventListener('scroll', scrollListener);
      scrollListener = null;
    }
  }

  document.addEventListener('astro:page-load', setupToc);
  document.addEventListener('astro:before-swap', cleanupToc);
</script>
