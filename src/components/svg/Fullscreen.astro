---
import type { HTMLAttributes } from 'astro/types';

/**
 * 全画面表示(展開)アイコンコンポーネント。
 * Google Material Symbols の fullscreen を採用。
 */
interface Props extends HTMLAttributes<'svg'> {
  /** 追加のCSSクラス名。 */
  class?: string;
  /** 装飾用アイコンとして支援技術から隠すかどうか(デフォルト: true)。 */
  ariaHidden?: boolean;
}

const { class: className, ariaHidden = true, ...rest } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="currentColor"
  focusable="false"
  class:list={['inline-block shrink-0', className]}
  aria-hidden={ariaHidden ? 'true' : undefined}
  {...rest}
>
  <path d="M3,21V16H5v3H8v2H3Zm13,0V19h3V16h2v5H16ZM3,8V3H8V5H5V8H3ZM19,8V5H16V3h5V8H19Z"></path>
</svg>
