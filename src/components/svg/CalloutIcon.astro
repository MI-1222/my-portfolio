---
import type { HTMLAttributes } from 'astro/types';

/**
 * コールアウト用アイコンコンポーネント。
 * Google Material Symbols のアイコンを採用。
 */
interface Props extends HTMLAttributes<'svg'> {
  /** コールアウトの種別。 */
  type: 'note' | 'tip' | 'important' | 'warning' | 'caution';
  /** 追加のCSSクラス名。 */
  class?: string;
  /** 装飾用アイコンとして支援技術から隠すかどうか(デフォルト: true)。 */
  ariaHidden?: boolean;
}

const { type, class: className, ariaHidden = true, ...rest } = Astro.props;

/** 種別ごとの SVG パス定義。 */
const PATH_MAP: Record<Props['type'], string> = {
  // Info (note)
