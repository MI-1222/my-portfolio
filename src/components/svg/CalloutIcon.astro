    'M8.25,21L3,15.75V8.25L8.25,3h7.5L21,8.25v7.5L15.75,21H8.25Zm0.9-4.75L12,13.4l2.85,2.85l1.4-1.4L13.4,12l2.85-2.85l-1.4-1.4L12,10.6L9.15,7.75l-1.4,1.4L10.6,12L7.75,14.85l1.4,1.4ZM9.1,19h5.8L19,14.9V9.1L14.9,5H9.1L5,9.1v5.8L9.1,19ZM12,12Z',
};

const pathData = PATH_MAP[type] ?? PATH_MAP.note;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="currentColor"
  focusable="false"
  class:list={['inline-block shrink-0', className]}
  aria-hidden={ariaHidden ? 'true' : undefined}
  {...rest}
>
  <path d={pathData}></path>
</svg>
