  // Lightbulb (tip)
  tip: 'M10,18q-0.82,0-1.41-0.59T8,16V14.75q-1.42-0.98-2.21-2.5T5,9Q5,6.07 7.04,4.04T12,2t4.96,2.04T19,9q0,1.72-0.79,3.24T16,14.75V16q0,0.82-0.59,1.41T14,18H10Zm0-2h4V13.7l0.85-0.6q1.02-0.7 1.59-1.79T17,9q0-2.07-1.46-3.54T12,4Q9.93,4 8.46,5.46Q7,6.93 7,9q0,1.22 0.56,2.31T9.15,13.1L10,13.7V16Zm0,6q-0.42,0-0.71-0.29Q9,21.43 9,21V20h6v1q0,0.43-0.29,0.71T14,22H10ZM12,9Z',
  // Speech bubble (important)
  important:
    'M6,14h8V12H6v2Zm0-3H18V9H6v2ZM6,8H18V6H6V8ZM2,22V4Q2,3.17 2.59,2.59T4,2H20q0.83,0 1.41,0.59T22,4V16q0,0.82-0.59,1.41T20,18H6L2,22Zm3.15-6H20V4H4V17.13L5.15,16ZM4,16V4V16Z',
  // Warning triangle (warning)
  warning:
    'M1,21L12,2L23,21H1Zm3.45-2h15.1L12,6L4.45,19Zm8.26-1.29Q13,17.43 13,17t-0.29-0.71T12,16t-0.71,0.29T11,17t0.29,0.71T12,18t0.71-0.29ZM11,15h2V10H11v5Zm1-2.5Z',
  // Octagonal stop/x (caution)
