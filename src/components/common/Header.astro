---
/**
 * サイト共通のヘッダーコンポーネント。
 * ブランドロゴ, 稼働ステータスインジケーター, ナビゲーション, 対話機能導線, テーマ切り替えボタン を含む。
 */
import Container from './Container.astro';
import ThemeToggle from './ThemeToggle.astro';

const currentPath = Astro.url.pathname;
const isHistoryActive =
  currentPath === '/history' || currentPath === '/history/';
---

<header class="sticky top-0 z-40 w-full border-b border-border-subtle bg-canvas/80 backdrop-blur-md transition-colors">
  <Container size="default" class="flex h-16 items-center justify-between">
    <!-- 左側: ブランドロゴとHUDステータスインジケーター。 -->
    <div class="flex items-center gap-3">
      <a
        href="/"
        class="group inline-flex items-center gap-2 font-mono text-sm font-semibold tracking-tight text-text-primary transition-colors hover:text-accent-cyan"
      >
        <span class="rounded bg-surface px-1.5 py-0.5 text-xs text-accent-cyan transition-shadow group-hover:shadow-[0_0_8px_rgba(86,212,221,0.4)]">
          &gt;_
        </span>
        <span class="tracking-wider">MI-1222</span>
      </a>

      <!-- システム稼働ステータス (HUDメタファー)。 -->
      <div class="hidden items-center gap-1.5 rounded-full border border-border-subtle bg-surface/60 px-2 py-0.5 font-mono text-[11px] text-text-secondary sm:inline-flex">
        <span class="relative flex size-2">
          <span class="absolute inline-flex size-full animate-ping rounded-full bg-accent-green opacity-75"></span>
          <span class="relative inline-flex size-2 rounded-full bg-accent-green"></span>
        </span>
        <span>SYS: NOMINAL</span>
      </div>
    </div>

    <!-- 右側: ナビゲーションリンク, アクションボタン。 -->
    <nav class="flex items-center gap-1.5 sm:gap-3">
      <a
        href="/#works"
        class="rounded-md px-2.5 py-1.5 font-mono text-xs text-text-secondary transition-colors hover:bg-surface hover:text-text-primary sm:text-sm"
      >
        Works
      </a>
      <a
        href="/history"
        class:list={[
          'rounded-md px-2.5 py-1.5 font-mono text-xs transition-colors sm:text-sm',
          isHistoryActive
            ? 'border border-border-subtle bg-surface font-semibold text-accent-cyan'
            : 'text-text-secondary hover:bg-surface hover:text-text-primary',
        ]}
      >
        History
      </a>

      <!-- 境界仕切り線。 -->
      <div class="h-4 w-px bg-border-subtle" aria-hidden="true"></div>

      <!-- ターミナルトグルボタン (今後実装予定)。 -->
      <button
        type="button"
        id="btn-terminal-trigger"
        class="relative inline-flex h-9 items-center gap-1 rounded-md border border-border-subtle bg-surface px-2.5 font-mono text-xs text-text-secondary transition-colors hover:border-accent-green/50 hover:text-accent-green focus:outline-none focus:ring-2 focus:ring-accent-green/30"
        aria-label="ターミナルモーダルを起動(準備中)"
        title="Interactive Terminal (Coming Soon)"
      >
        <span class="text-accent-green">&gt;_</span>
        <span class="hidden sm:inline">Term</span>
      </button>

      <!-- Command Palette (⌘K) ボタン (今後実装予定)。 -->
      <button
        type="button"
        id="btn-cmdk-trigger"
        class="hidden h-9 items-center gap-1 rounded-md border border-border-subtle bg-surface px-2 font-mono text-xs text-text-muted transition-colors hover:border-border-strong hover:text-text-primary focus:outline-none focus:ring-2 focus:ring-accent-cyan/30 sm:inline-flex"
        aria-label="クイック検索コマンドパレット(準備中)"
        title="Quick Search (Coming Soon)"
      >
        <kbd class="font-sans font-medium text-text-secondary">⌘</kbd>
        <kbd class="font-sans font-medium text-text-secondary">K</kbd>
      </button>

      <!-- テーマ切り替えトグル。 -->
      <ThemeToggle />
    </nav>
  </Container>
</header>

<!-- 開発中機能案内用のインライントースト。 -->
<div
  id="feature-toast"
  role="status"
  class="pointer-events-none fixed bottom-6 right-6 z-50 translate-y-4 rounded-md border border-border-strong bg-surface px-4 py-2 font-mono text-xs text-text-primary opacity-0 shadow-lg transition-all duration-300"
>
  <span id="feature-toast-msg"></span>
</div>

<script>
  /**
   * 開発中機能ボタンのクリック時に簡易トーストを表示する。
   */
  function setupFeatureTriggers(): void {
    const toast = document.getElementById('feature-toast');
    const toastMsg = document.getElementById('feature-toast-msg');
    const termBtn = document.getElementById('btn-terminal-trigger');
    const cmdkBtn = document.getElementById('btn-cmdk-trigger');

    let toastTimeout: number | undefined;

    const showToast = (message: string): void => {
      if (!toast || !toastMsg) {
        return;
      }
      toastMsg.textContent = message;
      toast.classList.remove(
        'opacity-0',
        'translate-y-4',
        'pointer-events-none',
      );
      toast.classList.add('opacity-100', 'translate-y-0');

      if (toastTimeout) {
        window.clearTimeout(toastTimeout);
      }
      toastTimeout = window.setTimeout(() => {
        toast.classList.remove('opacity-100', 'translate-y-0');
        toast.classList.add(
          'opacity-0',
          'translate-y-4',
          'pointer-events-none',
        );
      }, 2500);
    };

    termBtn?.addEventListener('click', () => {
      showToast('>_ Interactive Terminal: Coming Soon');
    });

    cmdkBtn?.addEventListener('click', () => {
      showToast('⌘K Command Palette: Coming Soon');
    });
  }

  document.addEventListener('astro:page-load', setupFeatureTriggers);
</script>
