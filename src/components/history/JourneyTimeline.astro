---
/**
 * 開発タイムラインコンポーネント。
 * `git log --graph` を模した縦型タイムラインにより、学習と開発の歩みを提示する。
 * HTML標準の <details> / <summary> を活用し、Zero JSで各コミットのアコーディオン開閉を実現。
 * 1つのブランチから複数回PRを発行・マージする実践的GitHubフローを可視化する。
 */
import { timelineCommits } from '../../data/history';

const branchAccentStyles = {
  cyan: {
    dot: 'border-accent-cyan bg-accent-cyan/20 text-accent-cyan',
    badge: 'border-accent-cyan/30 bg-accent-cyan/10 text-accent-cyan',
    line: 'bg-accent-cyan/40',
  },
  purple: {
    dot: 'border-accent-purple bg-accent-purple/20 text-accent-purple',
    badge: 'border-accent-purple/30 bg-accent-purple/10 text-accent-purple',
    line: 'bg-accent-purple/40',
  },
  coral: {
    dot: 'border-accent-coral bg-accent-coral/20 text-accent-coral',
    badge: 'border-accent-coral/30 bg-accent-coral/10 text-accent-coral',
    line: 'bg-accent-coral/40',
  },
  green: {
    dot: 'border-accent-green bg-accent-green/20 text-accent-green',
    badge: 'border-accent-green/30 bg-accent-green/10 text-accent-green',
    line: 'bg-accent-green/40',
  },
};
---

<section class="py-8 sm:py-12">
  <div class="mb-10 space-y-3">
    <!-- ブランチ色凡例。 -->
    <div class="flex flex-wrap items-center gap-2 pt-2 font-mono text-[11px] text-text-secondary">
      <span class="text-text-muted">Branches:</span>
      <span class="inline-flex items-center gap-1.5 rounded border border-border-subtle bg-surface px-2 py-0.5">
        <span class="size-2 rounded-full bg-accent-green"></span>
        <span>main</span>
      </span>
      <span class="inline-flex items-center gap-1.5 rounded border border-border-subtle bg-surface px-2 py-0.5">
        <span class="size-2 rounded-full bg-accent-cyan"></span>
        <span>feat/high-school</span>
      </span>
      <span class="inline-flex items-center gap-1.5 rounded border border-border-subtle bg-surface px-2 py-0.5">
        <span class="size-2 rounded-full bg-accent-coral"></span>
        <span>feat/engineering-journey</span>
      </span>
      <span class="inline-flex items-center gap-1.5 rounded border border-border-subtle bg-surface px-2 py-0.5">
        <span class="size-2 rounded-full bg-accent-purple"></span>
        <span>feat/systems-and-theory</span>
      </span>
    </div>
  </div>

  <!-- Gitログ風タイムライン。 -->
  <div class="relative pl-6 sm:pl-8">
    <!-- 縦方向のGitブランチ幹。 -->
    <div
      class="absolute bottom-4 left-2.5 top-3 w-px bg-border-subtle sm:left-3.5"
      aria-hidden="true"
    ></div>

    <div class="space-y-4">
      {timelineCommits.map((item) => {
        const style =
          branchAccentStyles[item.branchAccent] || branchAccentStyles.green;

        return (
          <div class="relative group">
            <div class="absolute -left-6 top-3.5 flex size-5 -translate-x-1/2 items-center justify-center sm:-left-8">
              {item.isPrMerge ? (
                <span class="flex size-4 items-center justify-center rounded-full border border-accent-purple bg-surface shadow-[0_0_8px_rgba(188,140,255,0.4)]">
                  <svg
                    class="size-2.5 text-accent-purple"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="3"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"
                    />
                  </svg>
                </span>
              ) : (
                <span
                  class:list={[
                    'size-2.5 rounded-full border transition-all duration-200 group-hover:scale-125',
                    style.dot,
                  ]}
                />
              )}
            </div>

            <details
              open={item.isDefaultOpen}
              class:list={[
                'rounded-lg border bg-surface transition-colors',
                item.isPrMerge
                  ? 'border-accent-purple/40 bg-surface/90 shadow-[0_0_12px_rgba(188,140,255,0.04)]'
                  : 'border-border-subtle hover:border-border-strong',
              ]}
            >
              <summary class="flex cursor-pointer items-center justify-between gap-3 p-3.5 select-none sm:p-4 [&::-webkit-details-marker]:hidden">
                <div class="flex min-w-0 flex-1 flex-wrap items-center gap-2 font-mono text-xs">
                  {item.isPrMerge ? (
                    <span class="rounded bg-accent-purple/20 px-2 py-0.5 font-bold text-accent-purple">
                      PR #{item.prNumber} MERGED
                    </span>
                  ) : (
                    <span class="rounded bg-surface-subtle px-1.5 py-0.5 text-text-muted group-hover:text-text-primary">
                      {item.hash}
                    </span>
                  )}
                  <span class="text-text-muted text-[11px] sm:text-xs">
                    {item.timestamp}
                  </span>
                  <span
                    class:list={[
                      'rounded border px-1.5 py-0.2 text-[10px] font-semibold tracking-wider',
                      style.badge,
                    ]}
                  >
                    {item.branch}
                  </span>
                  <span
                    class:list={[
                      'truncate font-semibold',
                      item.isPrMerge
                        ? 'text-accent-purple'
                        : 'text-text-primary group-hover:text-accent-cyan',
                    ]}
                  >
                    {item.commitMessage}
                  </span>
                </div>

                <div class="flex shrink-0 items-center text-text-muted transition-transform duration-200 group-open:rotate-90">
                  <span class="font-mono text-xs">▸</span>
                </div>
              </summary>

              <div class="space-y-4 border-t border-border-subtle/60 p-4 pt-3 text-xs sm:p-6 sm:text-sm">
                <div class="space-y-1">
                  <h3 class="text-sm font-bold text-text-primary sm:text-base">
                    {item.title}
                  </h3>
                  {item.isPrMerge && item.prTitle && (
                    <p class="font-mono text-xs text-accent-purple">
                      Pull Request: &quot;{item.prTitle}&quot;
                    </p>
                  )}
                </div>

                {item.closedIssue && (
                  <div class="flex items-start gap-2 rounded border border-accent-coral/30 bg-accent-coral/5 p-2.5 font-mono text-xs">
                    <span class="rounded bg-accent-coral/20 px-1.5 py-0.5 text-[10px] font-bold text-accent-coral shrink-0">
                      RESOLVED ISSUE #{item.closedIssue.number}
                    </span>
                    <span class="text-text-secondary leading-relaxed">
                      {item.closedIssue.title}
                    </span>
                  </div>
                )}

                <div class="space-y-2 leading-relaxed text-text-secondary">
                  <div>
                    <strong class="font-mono text-[11px] text-text-muted uppercase">
                      Context:{' '}
                    </strong>
                    <span>{item.context}</span>
                  </div>
                  <div>
                    <strong class="font-mono text-[11px] text-accent-cyan uppercase">
                      Achievement:{' '}
                    </strong>
                    <span>{item.achievement}</span>
                  </div>
                </div>

                <div class="flex flex-wrap gap-1.5 pt-2 border-t border-border-subtle/40">
                  {item.tags.map((tag) => (
                    <span class="rounded border border-border-subtle bg-surface-subtle px-2 py-0.5 font-mono text-[11px] text-text-muted">
                      #{tag}
                    </span>
                  ))}
                </div>
              </div>
            </details>
          </div>
        );
      })}
    </div>
  </div>
</section>
